# Nginx WebSSH HTTPS 反向代理配置示例 (/etc/nginx/conf.d/frp-webssh.conf)
# -------------------------------------------------------------------------
# 设计原理：
#   当客户端执行 `frpctl i 40090 -t webssh`（公网端口位于 40000~49999）时，
#   frpctl 会自动将底层 frpc 的 remote_port 设为 +10000（即 50090）。
#   服务端由 Nginx 统一监听公网 40090~40099 (HTTPS)，挂载域名 SSL 证书，
#   并将流量通过 WebSocket 反向代理至本机 127.0.0.1:50090~50099。
#   这样所有客户端无需分发证书即可直接通过 https://frp.example.com:40090 安全访问。
# -------------------------------------------------------------------------

map $http_upgrade $connection_upgrade {
    default upgrade;
    ''      close;
}

map $server_port $frp_backend_port {
    40090 50090;
    40091 50091;
    40092 50092;
    40093 50093;
    40094 50094;
    40095 50095;
    40096 50096;
    40097 50097;
    40098 50098;
    40099 50099;
}

server {
    listen 40090 ssl;
    listen 40091 ssl;
    listen 40092 ssl;
    listen 40093 ssl;
    listen 40094 ssl;
    listen 40095 ssl;
    listen 40096 ssl;
    listen 40097 ssl;
    listen 40098 ssl;
    listen 40099 ssl;

    # 修改为你的实际域名
    server_name frp.example.com;

    # 修改为你的实际 SSL 证书路径（例如 Let's Encrypt / acme.sh 签发的证书）
    ssl_certificate     /etc/letsencrypt/live/frp.example.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/frp.example.com/privkey.pem;

    # 允许通过右侧文件抽屉上传大文件（最大 2GB）
    client_max_body_size 2048m;

    location / {
        proxy_pass http://127.0.0.1:$frp_backend_port;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_set_header Host $http_host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_read_timeout 86400s;
        proxy_send_timeout 86400s;
        proxy_request_buffering off;
    }
}
